# Stripe Configuration
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
CLIENT_URL=http://localhost:5173

# Stripe Webhook Secret (for server-side purchase confirmation)
# Get this from Stripe Dashboard → Developers → Webhooks → Your endpoint → Signing secret
# Required for reliable purchase tracking via checkout.session.completed webhook
STRIPE_WEBHOOK_SECRET=

# Comp Code Unlock (Friend Trial)
# Set to "true" to enable comp code unlocks (disabled by default for production safety)
ENABLE_COMP_CODES=
# Format: leagueId1:CODE1,leagueId2:CODE2
# Example: 1204010527051763712:ROBTEST,demo-group-chat-dynasty:FREEDEMO
COMP_CODES=

# Free League Allowlist (no Stripe required)
# Server: comma-separated Sleeper league IDs that are always unlocked
# Example: 1389437091309432832
FREE_LEAGUE_IDS=
# Client (Vite): same list — embedded at build time for UI unlock
# Example: 1389437091309432832
VITE_FREE_LEAGUE_IDS=

# Analytics & Admin
# Required to access /api/stats and /api/admin/analytics/summary
# Generate a secure random string: openssl rand -hex 32
ADMIN_KEY=

# PostgreSQL connection string for persistent analytics + ranking history
# Required for durable ranking trends in production (Replit autoscale / NODE_ENV=production).
# Without it in production, rankings still work but trends stay flat (no local-file fallback).
# In development, if unset, ranking history uses .data/weekly-rankings.json.
# Example: postgres://user:pass@host:5432/dbname
DATABASE_URL=

# Weekly Commissioner Email (Resend)
# Get API key from https://resend.com — required to send weekly email to commissioner
RESEND_API_KEY=
# Optional: from address (must be verified in Resend). Default: onboarding@resend.dev
# RESEND_FROM=Fantasy Roast <notifications@yourdomain.com>
# Recap V2 insights (superlatives, roast intro, position leaders). Default on; set "false" to disable.
WEEKLY_EMAIL_V2_ENABLED=
